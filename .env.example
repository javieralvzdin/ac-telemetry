# Copia este archivo a ".env" y rellena valores propios antes de "docker compose up".
# ".env" NUNCA debe subirse al repositorio (ya está en .gitignore).

# --- InfluxDB ---
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=change-this-password
INFLUXDB_ORG=motorsport
INFLUXDB_BUCKET=assetto_corsa
# Genera un token propio (no reutilices el que estaba hardcodeado en el historial de git).
INFLUXDB_TOKEN=generate-a-real-random-token-here
# Cuanto tiempo se conservan los datos antes de borrarse automaticamente (ej: 90d, 30d, 0 = infinito)
INFLUXDB_RETENTION=90d

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-password
